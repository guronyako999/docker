# Переменные окружения для docker compose (скопируйте в .env и поменяйте при желании)
DB_NAME=aurora_db
DB_USER=aurora_user
DB_PASSWORD=aurora_pass

# Порт сайта на хосте (проброс). http://localhost:8080. Если 8080 занят — поменяйте.
WEB_PORT_HOST=8080

# Порт PostgreSQL на хосте (проброс). Если 5433/5434 заняты локальным postgres — поменяйте.
DB_PORT_HOST=5434
