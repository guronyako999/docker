# Переменные окружения для docker compose (скопируйте в .env и поменяйте при желании)
DB_NAME=aurora_db
DB_USER=aurora_user
DB_PASSWORD=aurora_pass

# Порт сайта на хосте (проброс). Сайт: http://localhost:8081
# (8080 был занят на вашей машине другой программой — если и 8081 занят, поменяйте цифру)
WEB_PORT_HOST=8081

# Порт PostgreSQL на хосте (проброс). Если 5433/5434 заняты локальным postgres — поменяйте.
DB_PORT_HOST=5434
